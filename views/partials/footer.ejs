  <!-- Footer -->
  <footer class="footer">
    <div class="footer-wave">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
        <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80 Z" fill="#0a1f3f"/>
      </svg>
    </div>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-brand-col">
          <div class="footer-logo">
            <svg viewBox="0 0 100 100" width="40" height="40">
              <ellipse cx="50" cy="50" rx="44" ry="30" fill="#1a3a5c" stroke="#d4a843" stroke-width="3"/>
              <line x1="50" y1="20" x2="50" y2="80" stroke="#d4a843" stroke-width="2.5"/>
              <line x1="34" y1="43" x2="66" y2="43" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"/>
              <line x1="33" y1="50" x2="67" y2="50" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"/>
              <line x1="34" y1="57" x2="66" y2="57" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span><%= site.teamName %></span>
          </div>
          <p class="footer-desc">Competitive youth football for 5th - 8th graders in Oshkosh, Wisconsin. Building champions on and off the field.</p>
          <div class="footer-social">
            <% if (site.facebook) { %>
              <a href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            <% } %>
            <% if (site.hudl) { %>
              <a href="<%= site.hudl %>" target="_blank" rel="noopener" class="footer-hudl-link">Hudl</a>
            <% } %>
          </div>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/calendar">Team Calendar</a></li>
            <li><a href="/registration">Registration</a></li>
            <li><a href="/sponsors">Sponsors</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul class="footer-contact-list">
            <% if (site.email) { %>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
              <a href="mailto:<%= site.email %>"><%= site.email %></a>
            </li>
            <% } %>
            <% if (site.phone) { %>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <a href="tel:<%= site.phone.replace(/[^0-9+]/g, '') %>"><%= site.phone %></a>
            </li>
            <% } %>
            <% if (site.mailingAddress) { %>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span><%= site.mailingAddress %></span>
            </li>
            <% } %>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Organization</h4>
          <ul>
            <li><a href="/contact">Board Members</a></li>
            <li><a href="/about">Our Coaches</a></li>
            <li><a href="/contact">Contact Us</a></li>
          </ul>
          <% if (site.league) { %>
          <div class="footer-league">
            <span>Member of</span>
            <strong><%= site.league %></strong>
          </div>
          <% } %>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= site.teamName %> Football Club. All rights reserved.</p>
        <p class="footer-usaf">All coaches are USA Football certified.</p>
        <p><a href="/admin/login" style="color: rgba(255,255,255,0.3); font-size: 0.75rem; text-decoration: none;">Site Admin</a></p>
      </div>
    </div>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
