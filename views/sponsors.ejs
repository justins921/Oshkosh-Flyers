<% var pageTitle = 'Sponsors'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="container page-hero-content">
    <span class="page-hero-tag">Our Partners</span>
    <h1>Sponsors</h1>
    <p><%= sponsors.headline %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Thank You</span>
      <h2>Our Sponsors</h2>
      <div class="section-divider"></div>
    </div>
    <p class="text-center body-text max-w-prose mx-auto reveal"><%= sponsors.description %></p>

    <% if (sponsors.sponsors && sponsors.sponsors.length > 0) { %>
      <div class="sponsors-grid">
        <% sponsors.sponsors.forEach(function(sponsor, i) { %>
          <div class="sponsor-card reveal" style="transition-delay: <%= i * 0.08 %>s">
            <% if (sponsor.logo) { %>
              <% if (sponsor.url) { %>
                <a href="<%= sponsor.url %>" target="_blank" rel="noopener">
                  <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" class="sponsor-logo">
                </a>
              <% } else { %>
                <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" class="sponsor-logo">
              <% } %>
            <% } else { %>
              <div class="sponsor-placeholder">
                <span><%= sponsor.name.charAt(0) %></span>
              </div>
            <% } %>
            <h4><%= sponsor.name %></h4>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state reveal">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <h3>Sponsors Coming Soon</h3>
        <p>Our sponsor list for the upcoming season will be posted here. Stay tuned!</p>
      </div>
    <% } %>
  </div>
</section>

<!-- Become a Sponsor CTA -->
<section class="section cta-section">
  <div class="cta-bg">
    <div class="cta-stripe cta-stripe-1"></div>
    <div class="cta-stripe cta-stripe-2"></div>
  </div>
  <div class="container cta-content reveal">
    <h2>Become a Sponsor</h2>
    <p><%= sponsors.becomeASponsor %></p>
    <a href="mailto:offcfundraising@gmail.com" class="btn btn-gold btn-lg">
      Get in Touch
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
    </a>
  </div>
</section>

<%- include('partials/footer') %>
