<%- include('partials/header') %>
<% var pageTitle = 'About Us'; %>

<section class="page-hero">
  <div class="container">
    <h1>About the Flyers</h1>
    <p>Learn about our organization, mission, and the people who make it happen.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="content-block">
      <div class="section-header">
        <h2>Our Story</h2>
        <div class="section-divider"></div>
      </div>
      <p class="body-text"><%= about.history %></p>
    </div>
  </div>
</section>

<section class="section bg-light">
  <div class="container">
    <div class="content-block">
      <div class="section-header">
        <h2>Our Mission</h2>
        <div class="section-divider"></div>
      </div>
      <blockquote class="mission-quote">
        "<%= about.missionStatement %>"
      </blockquote>
    </div>
  </div>
</section>

<% if (about.values) { %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Our Values</h2>
      <div class="section-divider"></div>
    </div>
    <div class="values-grid">
      <% about.values.split(',').forEach(function(value) { %>
        <div class="value-card">
          <h3><%= value.trim() %></h3>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (about.coaches && about.coaches.length > 0) { %>
<section class="section bg-light">
  <div class="container">
    <div class="section-header">
      <h2>Leadership</h2>
      <div class="section-divider"></div>
    </div>
    <div class="coaches-grid">
      <% about.coaches.forEach(function(coach) { %>
        <div class="coach-card">
          <div class="coach-avatar"><%= coach.name.charAt(0) %></div>
          <h3><%= coach.name %></h3>
          <% if (coach.role) { %><p class="coach-role"><%= coach.role %></p><% } %>
          <% if (coach.bio) { %><p class="coach-bio"><%= coach.bio %></p><% } %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
