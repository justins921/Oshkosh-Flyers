<% var pageTitle = 'Contact Us'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="container page-hero-content">
    <span class="page-hero-tag">Get In Touch</span>
    <h1>Contact Us</h1>
    <p>Reach out to the Oshkosh Flyers Football Club.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <!-- Contact Info -->
      <div class="contact-info-panel reveal">
        <h2>Contact Information</h2>
        <div class="contact-cards">
          <% if (contact.email) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
            </div>
            <div>
              <h4>General Inquiries</h4>
              <a href="mailto:<%= contact.email %>"><%= contact.email %></a>
            </div>
          </div>
          <% } %>
          <% if (contact.presidentEmail) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <h4>President</h4>
              <a href="mailto:<%= contact.presidentEmail %>"><%= contact.presidentEmail %></a>
            </div>
          </div>
          <% } %>
          <% if (contact.fundraisingEmail) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            </div>
            <div>
              <h4>Fundraising / Sponsorship</h4>
              <a href="mailto:<%= contact.fundraisingEmail %>"><%= contact.fundraisingEmail %></a>
            </div>
          </div>
          <% } %>
          <% if (contact.phone) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <div>
              <h4>Phone</h4>
              <a href="tel:<%= contact.phone.replace(/[^0-9+]/g, '') %>"><%= contact.phone %></a>
            </div>
          </div>
          <% } %>
          <div class="contact-addresses">
            <% if (contact.address) { %>
            <div class="contact-item">
              <div class="contact-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
              <div><h4>Location</h4><p><%= contact.address %></p></div>
            </div>
            <% } %>
            <% if (contact.mailingAddress) { %>
            <div class="contact-item">
              <div class="contact-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg></div>
              <div><h4>Mailing Address</h4><p><%= contact.mailingAddress %></p></div>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Board Members -->
      <div class="board-panel reveal" style="transition-delay: 0.15s">
        <h2>Board Members</h2>
        <% if (contact.boardMembers && contact.boardMembers.length > 0) { %>
          <div class="board-list">
            <% contact.boardMembers.forEach(function(member) { %>
              <div class="board-card">
                <div class="board-avatar"><%= member.name.charAt(0) %></div>
                <div class="board-info">
                  <h4><%= member.name %></h4>
                  <% if (member.role) { %><p class="board-role"><%= member.role %></p><% } %>
                  <% if (member.email) { %><p class="board-email"><a href="mailto:<%= member.email %>"><%= member.email %></a></p><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
