<%- include('partials/header') %>
<% var pageTitle = 'Contact Us'; %>

<section class="page-hero">
  <div class="container">
    <h1>Contact Us</h1>
    <p>Get in touch with the Oshkosh Flyers Football Club.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info-panel">
        <h2>Get In Touch</h2>

        <% if (contact.address) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h4>Location</h4>
              <p><%= contact.address %></p>
            </div>
          </div>
        <% } %>

        <% if (contact.mailingAddress) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
            </div>
            <div>
              <h4>Mailing Address</h4>
              <p><%= contact.mailingAddress %></p>
            </div>
          </div>
        <% } %>

        <% if (contact.email) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 006 0v-1a10 10 0 10-3.92 7.94"/></svg>
            </div>
            <div>
              <h4>Email</h4>
              <p><a href="mailto:<%= contact.email %>"><%= contact.email %></a></p>
            </div>
          </div>
        <% } %>

        <% if (contact.phone) { %>
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <div>
              <h4>Phone</h4>
              <p><%= contact.phone %></p>
            </div>
          </div>
        <% } %>
      </div>

      <% if (contact.boardMembers && contact.boardMembers.length > 0) { %>
        <div class="board-panel">
          <h2>Board Members</h2>
          <div class="board-list">
            <% contact.boardMembers.forEach(function(member) { %>
              <div class="board-card">
                <div class="board-avatar"><%= member.name.charAt(0) %></div>
                <div class="board-info">
                  <h4><%= member.name %></h4>
                  <% if (member.role) { %><p class="board-role"><%= member.role %></p><% } %>
                  <% if (member.email) { %><p><a href="mailto:<%= member.email %>"><%= member.email %></a></p><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
