<% var pageTitle = 'Resources'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="container page-hero-content">
    <span class="page-hero-tag">Downloads</span>
    <h1>Resources</h1>
    <p><%= resources.headline %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (resources.description) { %>
      <p class="text-center body-text max-w-prose mx-auto reveal"><%= resources.description %></p>
    <% } %>

    <% if (resources.resources && resources.resources.length > 0) { %>
      <%
        var categories = {};
        resources.resources.forEach(function(r) {
          var cat = r.category || 'General';
          if (!categories[cat]) categories[cat] = [];
          categories[cat].push(r);
        });
        var catKeys = Object.keys(categories);
      %>
      <% catKeys.forEach(function(cat, ci) { %>
        <div class="resources-category reveal" style="transition-delay: <%= ci * 0.1 %>s">
          <h2 class="resources-category-title"><%= cat %></h2>
          <div class="resources-list">
            <% categories[cat].forEach(function(resource, i) { %>
              <a href="<%= resource.url %>" target="_blank" rel="noopener" class="resource-card reveal" style="transition-delay: <%= (ci * 0.1) + (i * 0.06) %>s">
                <div class="resource-icon">
                  <% var ext = resource.filename ? resource.filename.split('.').pop().toLowerCase() : 'file'; %>
                  <% if (ext === 'pdf') { %>
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  <% } else if (ext === 'doc' || ext === 'docx') { %>
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                  <% } else if (ext === 'xls' || ext === 'xlsx' || ext === 'csv') { %>
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><rect x="8" y="12" width="8" height="6" rx="1"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <% } %>
                </div>
                <div class="resource-info">
                  <h3><%= resource.title %></h3>
                  <% if (resource.description) { %><p><%= resource.description %></p><% } %>
                  <span class="resource-meta"><%= ext.toUpperCase() %> document</span>
                </div>
                <div class="resource-download">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-state reveal">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <h3>Resources Coming Soon</h3>
        <p>Documents, waivers, and other resources will be posted here. Check back soon!</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
