<%- include('../partials/header') %>

<div class="admin-layout">
  <%- include('./sidebar') %>
  <div class="admin-main">
    <div class="admin-header">
      <h1>Manage Sponsors</h1>
      <p>Add sponsor logos and manage the sponsors page</p>
    </div>

    <div class="admin-card">
      <h2>Page Content</h2>
      <form method="POST" action="/admin/sponsors">
        <div class="form-group">
          <label for="headline">Headline</label>
          <input type="text" id="headline" name="headline" value="<%= sponsors.headline %>">
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3"><%= sponsors.description %></textarea>
        </div>
        <div class="form-group">
          <label for="becomeASponsor">Become a Sponsor Text</label>
          <textarea id="becomeASponsor" name="becomeASponsor" rows="2"><%= sponsors.becomeASponsor %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save Page Content</button>
      </form>
    </div>

    <div class="admin-card">
      <h2>Add New Sponsor</h2>
      <form method="POST" action="/admin/sponsors/add" enctype="multipart/form-data">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Sponsor Name</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="url">Website URL (optional)</label>
            <input type="url" id="url" name="url" placeholder="https://...">
          </div>
        </div>
        <div class="form-group">
          <label for="logo">Logo Image (optional)</label>
          <input type="file" id="logo" name="logo" accept="image/*">
        </div>
        <button type="submit" class="btn btn-primary">Add Sponsor</button>
      </form>
    </div>

    <div class="admin-card">
      <h2>Current Sponsors</h2>
      <% if (sponsors.sponsors && sponsors.sponsors.length > 0) { %>
        <ul class="item-list">
          <% sponsors.sponsors.forEach(function(sponsor) { %>
            <li>
              <div class="item-info" style="display: flex; align-items: center; gap: 12px;">
                <% if (sponsor.logo) { %>
                  <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" style="width: 40px; height: 40px; object-fit: contain; border-radius: 4px; background: #f5f5f5;">
                <% } %>
                <div>
                  <h4><%= sponsor.name %></h4>
                  <p><%= sponsor.url || 'No website' %></p>
                </div>
              </div>
              <div class="item-actions">
                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEdit('<%= sponsor.id %>')">Edit</button>
                <form method="POST" action="/admin/sponsors/delete/<%= sponsor.id %>" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Remove this sponsor?')">Remove</button>
                </form>
              </div>
            </li>
            <li id="edit-<%= sponsor.id %>" style="display: none; padding: 0;">
              <form method="POST" action="/admin/sponsors/edit/<%= sponsor.id %>" enctype="multipart/form-data" style="width: 100%; padding: 16px; background: var(--gray-50, #f9fafb); border-radius: 8px;">
                <div class="form-row">
                  <div class="form-group">
                    <label>Sponsor Name</label>
                    <input type="text" name="name" value="<%= sponsor.name %>" required>
                  </div>
                  <div class="form-group">
                    <label>Website URL (optional)</label>
                    <input type="url" name="url" value="<%= sponsor.url || '' %>" placeholder="https://...">
                  </div>
                </div>
                <div class="form-group">
                  <label>Logo Image</label>
                  <% if (sponsor.logo) { %>
                    <div style="margin-bottom: 8px;">
                      <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" style="max-height: 48px; max-width: 120px; object-fit: contain; border: 1px solid var(--gray-200); border-radius: 4px; padding: 4px; background: #fff;">
                      <span style="margin-left: 8px; font-size: 0.85rem; color: var(--text-light);">Current logo</span>
                    </div>
                  <% } %>
                  <input type="hidden" name="existingLogo" value="<%= sponsor.logo || '' %>">
                  <input type="file" name="logo" accept="image/jpeg,image/png,image/gif,image/webp">
                </div>
                <div style="display: flex; gap: 8px;">
                  <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEdit('<%= sponsor.id %>')">Cancel</button>
                </div>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p style="color: var(--text-light)">No sponsors added yet.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
function toggleEdit(id) {
  var el = document.getElementById('edit-' + id);
  el.style.display = el.style.display === 'none' ? '' : 'none';
}
</script>

<%- include('../partials/footer') %>
