<%- include('../partials/header') %>

<div class="admin-layout">
  <%- include('./sidebar') %>
  <div class="admin-main">
    <div class="admin-header">
      <h1>Edit Contact Page</h1>
      <p>Contact information and board members</p>
    </div>

    <div class="admin-card">
      <form method="POST" action="/admin/contact">
        <h2>Contact Information</h2>
        <div class="form-group">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= contact.address %>">
        </div>
        <div class="form-group">
          <label for="mailingAddress">Mailing Address</label>
          <input type="text" id="mailingAddress" name="mailingAddress" value="<%= contact.mailingAddress %>">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= contact.email %>">
          </div>
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" value="<%= contact.phone || '' %>">
          </div>
        </div>

        <h2 style="margin-top: 32px;">Board Members</h2>
        <div id="members-list">
          <% if (contact.boardMembers && contact.boardMembers.length > 0) { %>
            <% contact.boardMembers.forEach(function(member) { %>
              <div class="repeater-block">
                <div class="form-row">
                  <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="memberName" value="<%= member.name %>">
                  </div>
                  <div class="form-group">
                    <label>Role</label>
                    <input type="text" name="memberRole" value="<%= member.role %>">
                  </div>
                </div>
                <div class="form-group">
                  <label>Email</label>
                  <input type="email" name="memberEmail" value="<%= member.email || '' %>">
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
        <button type="button" class="add-btn" onclick="addMember()">+ Add Board Member</button>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/admin" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function addMember() {
  const list = document.getElementById('members-list');
  const block = document.createElement('div');
  block.className = 'repeater-block';
  block.innerHTML = `
    <div class="form-row">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="memberName" value="">
      </div>
      <div class="form-group">
        <label>Role</label>
        <input type="text" name="memberRole" value="">
      </div>
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="memberEmail" value="">
    </div>
  `;
  list.appendChild(block);
}
</script>

<%- include('../partials/footer') %>
