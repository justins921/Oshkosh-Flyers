<%- include('../partials/header') %>

<div class="admin-layout">
  <%- include('./sidebar') %>
  <div class="admin-main">
    <div class="admin-header">
      <h1>Manage Announcements</h1>
      <p>Add news and announcements that display on the home page</p>
    </div>

    <div class="admin-card">
      <h2>Add New Announcement</h2>
      <form method="POST" action="/admin/announcements/add">
        <div class="form-row">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required>
          </div>
          <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>">
          </div>
        </div>
        <div class="form-group">
          <label for="content">Content</label>
          <textarea id="content" name="content" rows="3" required></textarea>
        </div>
        <div class="form-group">
          <div class="form-check">
            <input type="checkbox" id="pinned" name="pinned">
            <label for="pinned">Pin this announcement</label>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Add Announcement</button>
      </form>
    </div>

    <div class="admin-card">
      <h2>Current Announcements</h2>
      <% if (announcements.items && announcements.items.length > 0) { %>
        <ul class="item-list">
          <% announcements.items.forEach(function(item) { %>
            <li>
              <div class="item-info">
                <h4><%= item.title %> <% if (item.pinned) { %><span class="status-badge status-open">Pinned</span><% } %></h4>
                <p><%= item.date %> &mdash; <%= item.content.substring(0, 80) %><%= item.content.length > 80 ? '...' : '' %></p>
              </div>
              <div class="item-actions">
                <form method="POST" action="/admin/announcements/delete/<%= item.id %>" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this announcement?')">Delete</button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p style="color: var(--text-light)">No announcements yet.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
